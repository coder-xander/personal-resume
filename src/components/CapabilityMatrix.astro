---
/**
 * CapabilityMatrix — 工程范围 / 能力矩阵
 *
 * 数据：src/data/site.ts 的 categories（8 个工程方向）与 projects（按 order 升序）。
 * 每个方向取 order 最小的 1–2 个项目作为代表项目，链接指向项目详情页。
 * 样式：只消费 tokens.css 变量（明暗主题自动适配），组件局部使用 .capability-* 类名。
 */
import { getCollection } from 'astro:content';
import { categories, projectUrl } from '../data/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const groups = categories.map((category) => ({
  category,
  representatives: projects
    .filter((project) => project.data.category === category.id)
    .slice(0, 2),
}));
---

<section class="capability" aria-labelledby="capability-heading">
  <div class="capability-head">
    <p class="eyebrow mono">
      <span class="signal-dot" aria-hidden="true"></span>// ENGINEERING SCOPE
    </p>
    <h2 id="capability-heading">八个方向<br />构成完整系统<span>.</span></h2>
    <p class="capability-intro">
      按工程方向整理关注点与代表项目。各层通过统一契约连接，说明设备系统、云端平台、客户端与产线工具如何组成可运行、可维护的完整系统。
    </p>
  </div>

  <ol class="capability-list" role="list">
    {groups.map((group, groupIndex) => (
      <li class="capability-item">
        <div class="capability-row">
          <span class="capability-index mono" aria-hidden="true">
            {String(groupIndex + 1).padStart(2, '0')}
          </span>

          <div class="capability-direction">
            <h3 class="capability-name">{group.category.title}</h3>
            <p class="capability-en mono">{group.category.en}</p>
          </div>

          <p class="capability-note">{group.category.note}</p>

          <div class="capability-projects">
            {group.representatives.map((project) => (
              <span class="capability-project">
                <a class="capability-link" href={projectUrl(project.id)}>
                  {project.data.title}
                </a>
              </span>
            ))}
          </div>

          <span class="capability-arrow" aria-hidden="true">↗</span>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  /* ---------- 区块 ------------------------------------------------------- */

  .capability {
    padding-block: var(--section-y);
  }

  /* ---------- 区块标题 --------------------------------------------------- */

  .capability-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.55fr);
    align-items: end;
    gap: var(--sp-4) var(--sp-9);
    padding-bottom: var(--sp-6);
    border-bottom: 1px solid var(--line);
  }

  .capability-head .eyebrow {
    grid-column: 1;
    grid-row: 1;
  }

  .capability-head h2 {
    grid-column: 1;
    grid-row: 2;
    margin-top: var(--sp-3);
    max-width: 18ch;
    font-size: var(--fs-h2);
    letter-spacing: var(--tracking-heading);
  }

  .capability-head h2 > span {
    color: var(--accent);
  }

  .capability-intro {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
    justify-self: end;
    max-width: 44ch;
    padding-bottom: 4px;
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: 1.85;
  }

  /* ---------- 列表 ------------------------------------------------------- */

  .capability-list {
    list-style: none;
  }

  .capability-item {
    position: relative;
  }

  .capability-row {
    position: relative;
    display: grid;
    grid-template-columns:
      3.25rem minmax(0, 0.95fr) minmax(0, 1.05fr) minmax(0, 1.5fr)
      1.5rem;
    align-items: center;
    gap: var(--sp-3) var(--sp-6);
    min-height: 72px;
    padding: 10px var(--sp-3) 10px var(--sp-4);
    border-bottom: 1px solid var(--line-soft);
    transition: background-color var(--dur) var(--ease);
  }

  /* hover / 键盘聚焦时出现的 lime 左侧竖线 */
  .capability-row::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 220ms var(--ease);
  }

  .capability-item:hover .capability-row,
  .capability-item:focus-within .capability-row {
    background: var(--accent-wash);
  }

  .capability-item:hover .capability-row::before,
  .capability-item:focus-within .capability-row::before {
    transform: scaleY(1);
  }

  .capability-item:last-child .capability-row {
    border-bottom: 0;
  }

  /* ---------- 序号 ------------------------------------------------------- */

  .capability-index {
    color: var(--subtle);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur) var(--ease);
  }

  .capability-item:hover .capability-index,
  .capability-item:focus-within .capability-index {
    color: var(--accent);
  }

  /* ---------- 方向 ------------------------------------------------------- */

  .capability-direction {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .capability-name {
    font-size: var(--fs-body-lg);
    font-weight: 550;
    line-height: 1.3;
    letter-spacing: var(--tracking-heading);
  }

  .capability-en {
    color: var(--subtle);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
  }

  /* ---------- 关注点 ----------------------------------------------------- */

  .capability-note {
    min-width: 0;
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: 1.7;
  }

  /* ---------- 代表项目 --------------------------------------------------- */

  .capability-projects {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px var(--sp-3);
    min-width: 0;
  }

  .capability-project {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  .capability-project + .capability-project::before {
    content: "/";
    margin-inline-end: var(--sp-2);
    color: var(--line-strong);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: 1;
  }

  .capability-link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    overflow-wrap: anywhere;
    border-radius: var(--radius-xs);
    color: var(--ink);
    font-size: var(--fs-meta);
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: var(--line-strong);
    transition:
      color var(--dur) var(--ease),
      text-decoration-color var(--dur) var(--ease);
  }

  .capability-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .capability-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* ---------- 箭头 ------------------------------------------------------- */

  .capability-arrow {
    justify-self: end;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    line-height: 1;
    transition:
      color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .capability-item:hover .capability-arrow,
  .capability-item:focus-within .capability-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  /* ---------- 中等宽度 --------------------------------------------------- */

  @media (max-width: 1080px) {
    .capability-row {
      grid-template-columns:
        3rem minmax(0, 0.95fr) minmax(0, 1fr) minmax(0, 1.35fr)
        1.5rem;
      gap: var(--sp-3) var(--sp-4);
    }
  }

  /* ---------- 移动端：堆叠布局 ------------------------------------------- */

  @media (max-width: 760px) {
    .capability-head {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--sp-4);
      padding-bottom: var(--sp-5);
    }

    .capability-head .eyebrow,
    .capability-head h2,
    .capability-intro {
      grid-column: 1;
      grid-row: auto;
    }

    .capability-head h2 {
      max-width: none;
    }

    .capability-intro {
      justify-self: stretch;
      max-width: none;
      padding-bottom: 0;
    }

    .capability-row {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      grid-template-areas:
        "index direction"
        ". note"
        ". projects";
      gap: var(--sp-2) var(--sp-3);
      min-height: 0;
      padding: var(--sp-4) var(--sp-2) var(--sp-5) var(--sp-3);
    }

    .capability-index {
      grid-area: index;
      padding-top: 3px;
    }

    .capability-direction {
      grid-area: direction;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px var(--sp-2);
    }

    .capability-name {
      font-size: 1.0625rem;
    }

    .capability-note {
      grid-area: note;
    }

    .capability-projects {
      grid-area: projects;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    /* 堆叠后每个项目独立成行，不再需要行内分隔符 */
    .capability-project + .capability-project::before {
      content: none;
    }

    .capability-arrow {
      display: none;
    }
  }
</style>
