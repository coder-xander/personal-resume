---
import Layout from '../layouts/Layout.astro';
import SearchPanel from '../components/SearchPanel.astro';
import { base } from '../data/site';
---
<Layout title="搜索项目 · Xander" description="搜索 Xander 的 Ropedia 项目经验、技术栈和工程问题。">
  <main id="main" class="container search-page">
    <nav class="breadcrumb search-breadcrumb" aria-label="面包屑">
      <a href={base}>主页</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">搜索</span>
    </nav>

    <div class="search-stage">
      <header class="search-head" data-reveal>
        <p class="eyebrow mono">// SEARCH THE WORK</p>
        <h1>找到一个项目，<br />也找到一个<span>问题的解法。</span></h1>
        <p class="search-page-intro">支持项目名称、中文描述和技术关键词。试试 OTA、相机、标定或 WebRTC。</p>
      </header>

      <div class="search-panel-slot" data-reveal style="--reveal-delay: 120ms">
        <SearchPanel expanded />
      </div>

      <div class="search-actions">
        <a href={`${base}#projects`} class="text-link">浏览全部项目 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </main>
</Layout>
