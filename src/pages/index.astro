---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CapabilityMatrix from '../components/CapabilityMatrix.astro';
import { categories, categoryInfo, site, projectUrl } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const picked = projects.filter((project) => project.data.featured);
const featured = (picked.length ? picked : projects.slice(0, 5)).slice(0, 6);
const categoryCounts = new Map(
  categories.map((category) => [category.id, projects.filter((project) => project.data.category === category.id).length]),
);

const layers = [
  { en: 'SYSTEM', title: '启动与系统', sub: 'Linux / U-Boot / BSP', anchor: 'system' },
  { en: 'DEVICE', title: '采集与设备服务', sub: 'C++ / Go / Zenoh', anchor: 'device' },
  { en: 'CLOUD', title: '设备云与运维', sub: 'MQTT / PostgreSQL / OTA', anchor: 'cloud' },
  { en: 'APPLICATION', title: '桌面应用', sub: 'Go / Wails / React', anchor: 'client' },
  { en: 'FACTORY', title: '产线与标定', sub: 'Electron / Tauri / Airflow', anchor: 'factory' },
  { en: 'INTELLIGENCE', title: 'Vera Agent', sub: 'ADK / MCP / Gemini', anchor: 'ai' },
];

const languageLabel = (project: (typeof projects)[number]) =>
  project.data.languages.map((language) => language.split('（')[0]).join(' / ');

const searchText = (project: (typeof projects)[number]) =>
  [
    project.data.title,
    project.data.summary,
    categoryInfo(project.data.category).title,
    categoryInfo(project.data.category).en,
    ...project.data.languages,
    ...project.data.technologies,
  ]
    .join(' ')
    .toLowerCase();
---

<Layout title="Xander · 系统架构与全栈工程师">
  <main id="main" class="home-main">
    <!-- 01 · HERO ------------------------------------------------------------>
    <section class="hero" id="about" aria-labelledby="hero-heading">
      <div class="hero-ambience" aria-hidden="true"></div>

      <div class="hero-inner container">
        <div class="hero-copy">
          <p class="eyebrow mono hero-eyebrow">
            <span class="signal-dot" aria-hidden="true"></span>系统架构与全栈工程师 · 上海
          </p>
          <h1 id="hero-heading" class="hero-title">
            从底层系统，<br />到<span>完整产品。</span>
          </h1>
          <p class="hero-identity">
            <strong>Xander</strong> 在 Ropedia 独立完成设备系统、采集服务、管理平台、客户端与产线工具的架构设计与实现。
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#featured">查看精选项目 <span aria-hidden="true">↓</span></a>
            <a class="btn" href="#projects">{projects.length} 个项目索引</a>
            <a class="hero-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          </div>
          <p class="hero-meta mono">
            <span>{site.location}</span>
            <span class="hero-meta-sep" aria-hidden="true"></span>
            <span>独立架构设计 × 完整实现</span>
          </p>
        </div>

        <aside class="atlas-panel panel" aria-label="从系统到应用的工程层级">
          <div class="atlas-head mono">
            <span>THE ENGINEERING STACK</span>
            <span class="atlas-plus" aria-hidden="true">+</span>
          </div>
          <ol class="atlas-list">
            {layers.map((layer, index) => (
              <li class="atlas-item">
                <a class="atlas-layer" href="#projects" data-layer={layer.anchor}>
                  <span class="atlas-index mono">0{index + 1}</span>
                  <span class="atlas-body">
                    <span class="atlas-name">{layer.title}</span>
                    <span class="atlas-tech mono">{layer.sub}</span>
                  </span>
                  <span class="atlas-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
          <div class="atlas-foot mono">
            <span>HARDWARE → DATA → EXPERIENCE</span>
            <span class="atlas-signal" aria-hidden="true">▂ ▃ ▅ ▇</span>
          </div>
        </aside>
      </div>
    </section>

    <!-- 02 · SIGNAL BAND ----------------------------------------------------->
    <section class="signal-band" aria-label="工作范围">
      <div class="container signal-inner">
        <p class="signal-text">
          在 Ropedia 独立完成 <strong>系统 · 数据 · 云端 · 客户端 · 产线</strong> 的架构与实现
        </p>
        <p class="signal-meta mono">{projects.length} PROJECTS · {categories.length} DOMAINS · 6 LAYERS</p>
      </div>
    </section>

    <!-- 03 · SELECTED WORK --------------------------------------------------->
    <section class="featured-section section" id="featured" aria-labelledby="featured-heading">
      <div class="container">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow mono">// SELECTED WORK</p>
            <h2 id="featured-heading">从固件到 Agent<span>.</span></h2>
          </div>
          <p class="section-note">
            以下 {featured.length} 个项目代表系统的关键层级，<br />其余项目列在下方索引中。
          </p>
        </div>

        <ol class="featured-list">
          {featured.map((project, index) => {
            const category = categoryInfo(project.data.category);
            return (
              <li class="featured-item">
                <a class="featured-row" href={projectUrl(project.id)}>
                  <span class="featured-index mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <span class="featured-main">
                    <span class="featured-kicker mono">{category.title} · {category.en}</span>
                    <span class="featured-title">{project.data.title}</span>
                    <span class="featured-summary">{project.data.summary}</span>
                  </span>
                  <span class="featured-side">
                    <span class="featured-tags">
                      {project.data.technologies.slice(0, 4).map((tag) => <span>{tag}</span>)}
                    </span>
                    <span class="featured-foot">
                      <span class="featured-langs mono">{languageLabel(project)}</span>
                      <span class="arrow-tile featured-arrow" aria-hidden="true">↗</span>
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ol>

        <a class="featured-all" href="#projects">
          查看全部 {projects.length} 个项目 <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <!-- 04 · PROJECT INDEX --------------------------------------------------->
    <section class="projects-section section" id="projects" aria-labelledby="projects-heading">
      <div class="container">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow mono">// PROJECT INDEX</p>
            <h2 id="projects-heading">逐层展开，<br />逐项说明<span>.</span></h2>
          </div>
          <p class="section-note">
            按工程方向筛选，或输入项目名与技术关键词。<br />每个项目都有独立详情页。
          </p>
        </div>

        <div class="project-tools" data-project-toolbar hidden>
          <label class="project-filter" for="project-filter">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
            <span class="sr-only">筛选项目</span>
            <input id="project-filter" type="search" placeholder="筛选项目、技术或方向…" autocomplete="off" />
          </label>
          <p class="project-count mono" aria-live="polite">
            <span id="project-count">{projects.length}</span> 个项目
          </p>
        </div>

        <div class="category-filters" role="group" aria-label="按工程方向筛选" data-project-toolbar hidden>
          <button type="button" data-category-filter="all" class="active" aria-pressed="true">
            全部 <span>{projects.length}</span>
          </button>
          {categories.map((category) => (
            <button type="button" data-category-filter={category.id} aria-pressed="false">
              {category.title} <span>{categoryCounts.get(category.id)}</span>
            </button>
          ))}
        </div>

        <ol class="project-index">
          {projects.map((project) => {
            const category = categoryInfo(project.data.category);
            const order = String(project.data.order).padStart(2, '0');
            return (
              <li
                class="project-row"
                data-project-row
                data-category={project.data.category}
                data-search={searchText(project)}
                data-reveal
              >
                <a class="project-row-link" href={projectUrl(project.id)}>
                  <span class="project-row-num mono" aria-hidden="true">{order}</span>
                  <span class="project-row-main">
                    <span class="project-row-title">{project.data.title}</span>
                    <span class="project-row-summary">{project.data.summary}</span>
                  </span>
                  <span class="project-row-domain mono">{category.en}</span>
                  <span class="project-row-langs mono">{languageLabel(project)}</span>
                  <span class="project-row-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            );
          })}
        </ol>
        <p class="project-empty" id="project-empty" hidden>没有匹配的项目，换个关键词或方向试试。</p>
      </div>
    </section>

    <!-- 05 · ENGINEERING SCOPE ---------------------------------------------->
    <div id="scope" class="scope-section">
      <div class="container">
        <CapabilityMatrix />
      </div>
    </div>

    <!-- 06 · CONTACT --------------------------------------------------------->
    <section class="contact-section section" id="contact" aria-labelledby="contact-heading">
      <div class="container contact-inner">
        <div class="contact-head" data-reveal>
          <p class="eyebrow mono">// CONTACT</p>
          <h2 id="contact-heading">聊聊系统，<br />或者下一个完整产品<span>.</span></h2>
        </div>
        <div class="contact-copy" data-reveal>
          <p>
            想了解某个项目的架构取舍与实现细节，或讨论设备系统与全栈交付，欢迎直接联系。
          </p>
          <div class="contact-actions">
            <a class="btn btn-primary" href={`mailto:${site.email}`}>发邮件 <span aria-hidden="true">↗</span></a>
            <a class="btn" href={site.github} target="_blank" rel="noopener noreferrer">GitHub / @{site.handle} <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#projects">查看项目 <span aria-hidden="true">↑</span></a>
          </div>
          <p class="contact-note mono">MAIL / GITHUB / {site.location}</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const rows = [...document.querySelectorAll<HTMLElement>('[data-project-row]')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
  const input = document.querySelector<HTMLInputElement>('#project-filter');
  const counter = document.querySelector<HTMLElement>('#project-count');
  const empty = document.querySelector<HTMLElement>('#project-empty');
  const toolbars = [...document.querySelectorAll<HTMLElement>('[data-project-toolbar]')];

  if (rows.length && filters.length) {
    let category = 'all';

    const apply = () => {
      const term = (input?.value ?? '').trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const matchesCategory = category === 'all' || row.dataset.category === category;
        const matchesTerm = !term || (row.dataset.search ?? '').includes(term);
        const show = matchesCategory && matchesTerm;
        row.hidden = !show;
        if (show) visible += 1;
      }
      if (counter) counter.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
    };

    for (const button of filters) {
      button.addEventListener('click', () => {
        category = button.dataset.categoryFilter ?? 'all';
        for (const item of filters) {
          const active = item === button;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', String(active));
        }
        apply();
      });
    }

    input?.addEventListener('input', apply);

    // The atlas layers double as category shortcuts.
    document.querySelectorAll<HTMLElement>('[data-layer]').forEach((link) => {
      link.addEventListener('click', () => {
        const target = filters.find((button) => button.dataset.categoryFilter === link.dataset.layer);
        target?.click();
      });
    });

    for (const toolbar of toolbars) toolbar.hidden = false;
    apply();
  }
</script>
