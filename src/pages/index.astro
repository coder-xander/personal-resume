---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SearchPanel from '../components/SearchPanel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { categories, site, projectUrl } from '../data/site';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const layers = [
  { en: 'SYSTEM', title: '启动与系统', sub: 'Linux / U-Boot / BSP', anchor: 'system' },
  { en: 'DEVICE', title: '采集与设备服务', sub: 'C++ / Go / Zenoh', anchor: 'device' },
  { en: 'CLOUD', title: '设备云与运维', sub: 'MQTT / PostgreSQL / OTA', anchor: 'cloud' },
  { en: 'APPLICATION', title: '桌面与移动端', sub: 'Wails / React / Expo', anchor: 'client' },
  { en: 'FACTORY', title: '产线与标定', sub: 'Electron / Tauri / Airflow', anchor: 'factory' },
  { en: 'INTELLIGENCE', title: 'Vera Agent 与本地物体检测', sub: 'ADK / MCP / Grounding DINO', anchor: 'ai' },
];
---
<Layout>
  <main id="main" class="home-main">
    <section class="hero-section container" id="about" aria-labelledby="hero-heading">
      <div class="hero-content"><p class="eyebrow mono"><span class="signal-dot"></span> XANDER / SYSTEM ARCHITECTURE</p><h1 id="hero-heading">从底层系统，<br/>到<span>完整产品。</span></h1><p class="hero-intro">{site.intro}</p><div class="hero-meta"><span>{site.location}</span><span>独立架构设计 × 完整实现</span></div><SearchPanel /><a class="hero-explore mono" href="#projects">EXPLORE THE WORK <span aria-hidden="true">↓</span></a></div>
      <div class="stack-atlas" aria-label="从系统到应用的工程层级"><div class="atlas-heading mono"><span>THE ENGINEERING STACK</span><span class="atlas-cross">+</span></div><div class="atlas-grid">{layers.map((layer, index) => <a class="atlas-layer" href="#projects" data-layer={layer.anchor}><span class="layer-index mono">0{index + 1}</span><div><span class="layer-name">{layer.title}</span><span class="layer-tech mono">{layer.sub}</span></div><span class="layer-connector" aria-hidden="true">↗</span></a>)}</div><div class="atlas-footer mono"><span>HARDWARE → DATA → EXPERIENCE</span><span class="atlas-signal" aria-hidden="true">▂ ▃ ▅ ▇</span></div></div>
    </section>
    <section class="scope-strip" aria-label="项目范围"><div class="container scope-inner"><p class="mono">ROPEDIA × PERSONAL WORK</p><span>{projects.length} 个项目主题</span><span>{categories.length} 个工程方向</span><p>独立设计与实现，说明每层如何组成完整系统。</p></div></section>
    <section class="architecture-section container" aria-labelledby="architecture-heading">
      <div class="section-heading"><div><p class="eyebrow mono">// SYSTEM ARCHITECTURE</p><h2 id="architecture-heading">我设计的是<br/>一套完整的系统<span>.</span></h2></div><p class="section-note">从需求拆解、技术选型到接口定义，<br/>再到代码实现、部署与维护。</p></div>
      <p class="architecture-intro">这些项目由我独立完成整体架构设计与实现。我围绕同一套设备产品，统一控制入口、数据契约、任务状态与设备身份，让系统、云端、应用和产线工具能够共同工作。</p>
      <div class="architecture-grid">
        <a href={projectUrl('device-core')} class="architecture-card"><span class="mono">01 / CONTROL &amp; DATA</span><h3>控制面与数据面分离</h3><p>Device Core 统一 BLE、HTTP、MQTT 和按键的业务规则。采集、录制与预览分别运行，通过 Zenoh 共享数据，以租约和有界队列管理消费关系。</p><span class="architecture-destination">设备架构 ↗</span></a>
        <a href={projectUrl('device-cloud')} class="architecture-card"><span class="mono">02 / STATE &amp; LIFECYCLE</span><h3>贯穿设备生命周期</h3><p>设备身份连接刷写、出厂、测试、标定、运行与 OTA。Cloud 以任务和设备回执确认结果，客户端与现场工具复用同一控制规则和档案。</p><span class="architecture-destination">平台架构 ↗</span></a>
        <a href={projectUrl('desktop')} class="architecture-card"><span class="mono">03 / APPLICATION &amp; DELIVERY</span><h3>分层实现与独立交付</h3><p>按硬件访问、业务控制、通信和交互划分模块。应用连接与后台任务拥有各自生命周期，版本、校验信息和发布流程贯穿设备与客户端。</p><span class="architecture-destination">客户端架构 ↗</span></a>
        <a href={projectUrl('vera-agent')} class="architecture-card"><span class="mono">04 / AGENT &amp; INFERENCE</span><h3>两条 AI 应用链路</h3><p>Vera 通过 ADK 与 MCP 使用平台权限、工具和设备回执。本地物体检测消费 Desktop 预览数据，在独立推理进程运行，结果叠加与原始录制分开。</p><span class="architecture-destination">Vera Agent 架构 ↗</span></a>
      </div>
    </section>
    <section class="projects-section container" id="projects" aria-labelledby="projects-heading"><div class="section-heading"><div><p class="eyebrow mono">// PROJECT INDEX</p><h2 id="projects-heading">逐层展开，逐项说明<span>.</span></h2></div><p class="section-note">从设备启动到数据采集，<br/>从工程工具到用户应用。</p></div><div class="project-controls"><div class="category-filters" role="group" aria-label="按技术层级筛选"><button type="button" data-category-filter="all" class="active" aria-pressed="true">全部 <span>{projects.length}</span></button>{categories.map((category) => <button type="button" data-category-filter={category.id} aria-pressed="false">{category.title}</button>)}</div><p class="project-count mono" aria-live="polite"><span id="project-count">{projects.length}</span> PROJECTS</p></div><div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div></section>
    <section class="about-section container" aria-labelledby="working-heading"><div class="about-heading"><p class="eyebrow mono">// HOW I WORK</p><h2 id="working-heading">从系统边界<br/>落实到代码<span>.</span></h2></div><div class="about-detail"><p>我的工作从产品需求和系统约束出发，定义模块职责、接口、数据流与状态，再完成各层代码和交付流程。底层采集、设备控制、云端管理、客户端与产线工具都围绕同一套产品架构展开。</p><p>架构取舍体现在具体实现里：预览退出不影响录制，连接恢复不擅自启动采集，升级任务不依赖业务进程，Agent 操作由平台权限和设备回执约束。项目详情逐项说明这些设计如何落地。</p><a href={site.github} target="_blank" rel="noopener noreferrer" class="text-link">GitHub / @{site.handle}<span aria-hidden="true">↗</span></a></div></section>
  </main>
</Layout>
<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project-card]')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
  function filterProjects(category: string) {
    let count = 0;
    cards.forEach((card) => { const show = category === 'all' || card.dataset.category === category; card.hidden = !show; if (show) count++; });
    filters.forEach((button) => { const active = button.dataset.categoryFilter === category; button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active)); });
    document.querySelector('#project-count')!.textContent = String(count);
  }
  filters.forEach((button) => button.addEventListener('click', () => filterProjects(button.dataset.categoryFilter!)));
  document.querySelectorAll<HTMLElement>('[data-layer]').forEach((link) => link.addEventListener('click', () => filterProjects(link.dataset.layer!)));
</script>
